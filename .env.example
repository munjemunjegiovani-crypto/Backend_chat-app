# PostgreSQL connection string (Neon: Dashboard > Connection Details > copy the "postgresql://..." URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# A long random secret used to sign login tokens. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Your front-end URL(s), comma separated. Example: https://kova-chat.netlify.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Max upload size in MB for photos, videos, voice notes and files
MAX_UPLOAD_MB=15

# Optional: WebRTC servers for calls (JSON). Leave empty to use free Google STUN servers.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:YOUR_TURN_HOST:3478","username":"USER","credential":"PASS"}]

PORT=4000
